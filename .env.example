# --- Anthropic (résumé des actus) ---
ANTHROPIC_API_KEY=

# --- Supabase (abonnés + historique des digests) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (notifications) ---
# Génère-les avec: npm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:charly.his74@gmail.com

# --- Sécurité du endpoint cron ---
# Choisis une valeur aléatoire longue, à mettre aussi dans l'en-tête
# Authorization: Bearer <CRON_SECRET> de la requête cron (Vercel Cron le fait automatiquement
# si tu passes par vercel.json + cette variable).
CRON_SECRET=
